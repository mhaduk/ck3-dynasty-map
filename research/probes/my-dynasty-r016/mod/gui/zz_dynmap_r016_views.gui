# Original narrow banner composition; native children remain native types.
# Intentional second native identifier override; no HUD/vanilla body is copied.
# Custom child is OUTSIDE map_mode_banner_sub_modes: hud_bottom overrides it.
types dynmap_r016_views
{
    type widget_map_mode_banner = widget
    {
        parentanchor = bottom|hcenter
        size = { 100% 100 }
        allow_outside = yes
        block "banner_visibility" { visible = "[Not(IsMapMode('realms'))]" }
        state = { name = _show using = Animation_FadeIn_Quick }
        state = { name = _hide using = Animation_FadeOut_Standard }
        block "map_mode_banner_background" {}
        block "map_mode_banner_sub_modes" {
            block "map_mode_icon_selection" {
                faith_mini_map_mode_icon_selection_container = { parentanchor = top|hcenter position = { 0 -72 } }
            }
            faith_mini_map_mode = { parentanchor = top|hcenter position = { 0 -27 } }
        }
        # Keep native headers/close control and their nested instance seams.
        flowcontainer_map_mode_header = {
            parentanchor = center
            visible = "[Not(Or3(IsMapMode('dynmap_my_dynasty'), IsMapMode('dynmap_dynasty_holdings'), IsMapMode('dynmap_my_realm_dynasty')))]"
        }
        flowcontainer = {
            name = "dynmap_r016_active_subviews"
            parentanchor = bottom|hcenter
            widgetanchor = bottom|hcenter
            position = { 0 -12 }
            direction = vertical
            spacing = 4
            ignoreinvisible = yes
            visible = "[And(GetPlayer.IsValid, Or3(IsMapMode('dynmap_my_dynasty'), IsMapMode('dynmap_dynasty_holdings'), IsMapMode('dynmap_my_realm_dynasty')))]"
            widget = {
                name = "dynmap_r016_modifier_row_host"
                parentanchor = hcenter
                size = { 130 40 }
                flowcontainer = {
                    name = "dynmap_r016_normal_row"
                    parentanchor = top|left
                    widgetanchor = top|left
                    direction = horizontal
                    spacing = 5
                    visible = "[And(GetPlayer.IsValid, Not(And(IsAltDown, IsShiftDown)))]"
                    button_round = {
                        name = "dynmap_r016_view_realms"
                        parentanchor = center
                        size = { 40 40 }
                        visible = "[GetPlayer.IsValid]"
                        enabled = "[And(CanChangeMapMode, GetScriptedGui('dynmap_r016_check').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ))]"
                        down = "[IsMapMode('dynmap_my_dynasty')]"
                        tooltip = "dynmap_r016_realms_tt"
                        onclick = "[GetScriptedGui(Select_CString(IsAltDown, 'dynmap_r016_samples_realms', Select_CString(IsShiftDown, 'dynmap_r016_summary_realms', 'dynmap_r016_refresh_realms'))).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('dynmap_r016_palette_id', MakeScopeValue(GetPlayer.MakeScope.GetVariable('dynmap_r016_pair_cache_id').GetValueWithDefault(IntToFixedPoint('(int32)126')))).AddScope('dynmap_r016_pair_c1_r', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetR_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)1')))))).AddScope('dynmap_r016_pair_c1_g', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetG_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)1')))))).AddScope('dynmap_r016_pair_c1_b', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetB_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)1')))))).AddScope('dynmap_r016_pair_c2_r', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetR_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)2')))))).AddScope('dynmap_r016_pair_c2_g', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetG_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)2')))))).AddScope('dynmap_r016_pair_c2_b', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetB_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)2')))))).End )]"
                        onclick = "[SetMapMode('dynmap_my_dynasty')]"
                        button_icon = {
                            size = { 26 26 }
                            parentanchor = center
                            alwaystransparent = yes
                            texture = "gfx/interface/icons/flat_icons/map_modes/dejure_kingdoms.dds"
                            down = "[IsMapMode('dynmap_my_dynasty')]"
                        }
                    }
                    button_round = {
                        name = "dynmap_r016_view_holdings"
                        parentanchor = center
                        size = { 40 40 }
                        visible = "[GetPlayer.IsValid]"
                        enabled = "[And(CanChangeMapMode, GetScriptedGui('dynmap_r016_check').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ))]"
                        down = "[IsMapMode('dynmap_dynasty_holdings')]"
                        tooltip = "dynmap_r016_holdings_tt"
                        onclick = "[GetScriptedGui(Select_CString(IsAltDown, 'dynmap_r016_samples_holdings', Select_CString(IsShiftDown, 'dynmap_r016_summary_holdings', 'dynmap_r016_refresh_holdings'))).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('dynmap_r016_palette_id', MakeScopeValue(GetPlayer.MakeScope.GetVariable('dynmap_r016_pair_cache_id').GetValueWithDefault(IntToFixedPoint('(int32)126')))).AddScope('dynmap_r016_pair_c1_r', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetR_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)1')))))).AddScope('dynmap_r016_pair_c1_g', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetG_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)1')))))).AddScope('dynmap_r016_pair_c1_b', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetB_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)1')))))).AddScope('dynmap_r016_pair_c2_r', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetR_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)2')))))).AddScope('dynmap_r016_pair_c2_g', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetG_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)2')))))).AddScope('dynmap_r016_pair_c2_b', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetB_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)2')))))).End )]"
                        onclick = "[SetMapMode('dynmap_dynasty_holdings')]"
                        button_icon = {
                            size = { 26 26 }
                            parentanchor = center
                            alwaystransparent = yes
                            texture = "gfx/interface/icons/holding_types_tab/castle_holding.dds"
                            down = "[IsMapMode('dynmap_dynasty_holdings')]"
                        }
                    }
                    button_round = {
                        name = "dynmap_r016_view_my_realm"
                        parentanchor = center
                        size = { 40 40 }
                        visible = "[GetPlayer.IsValid]"
                        enabled = "[And(CanChangeMapMode, GetScriptedGui('dynmap_r016_check').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ))]"
                        down = "[IsMapMode('dynmap_my_realm_dynasty')]"
                        tooltip = "dynmap_r016_my_realm_tt"
                        onclick = "[GetScriptedGui(Select_CString(IsAltDown, 'dynmap_r016_samples_my_realm', Select_CString(IsShiftDown, 'dynmap_r016_summary_my_realm', 'dynmap_r016_refresh_my_realm'))).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('dynmap_r016_palette_id', MakeScopeValue(GetPlayer.MakeScope.GetVariable('dynmap_r016_pair_cache_id').GetValueWithDefault(IntToFixedPoint('(int32)126')))).AddScope('dynmap_r016_pair_c1_r', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetR_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)1')))))).AddScope('dynmap_r016_pair_c1_g', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetG_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)1')))))).AddScope('dynmap_r016_pair_c1_b', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetB_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)1')))))).AddScope('dynmap_r016_pair_c2_r', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetR_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)2')))))).AddScope('dynmap_r016_pair_c2_g', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetG_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)2')))))).AddScope('dynmap_r016_pair_c2_b', MakeScopeValue(IntToFixedPoint(DynmapR016Byte(GetB_CVector4f(GetPlayer.GetDynasty.GetDynastyCoA.GetColor('(int32)2')))))).End )]"
                        onclick = "[SetMapMode('dynmap_my_realm_dynasty')]"
                        button_icon = {
                            size = { 26 26 }
                            parentanchor = center
                            alwaystransparent = yes
                            texture = "gfx/interface/icons/flat_icons/house.dds"
                            down = "[IsMapMode('dynmap_my_realm_dynasty')]"
                        }
                    }
                }
                flowcontainer = {
                    name = "dynmap_r016_audit_row"
                    parentanchor = top|left
                    widgetanchor = top|left
                    direction = horizontal
                    spacing = 5
                    visible = "[And(GetPlayer.IsValid, And(IsAltDown, IsShiftDown))]"
                    button_round = {
                        name = "dynmap_r016_view_realms_audit"
                        parentanchor = center
                        size = { 40 40 }
                        visible = "[GetPlayer.IsValid]"
                        enabled = "[And(CanChangeMapMode, GetScriptedGui('dynmap_r016_check').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ))]"
                        down = "[IsMapMode('dynmap_my_dynasty')]"
                        tooltip = "dynmap_r016_realms_tt"
                        onclick = "[GetScriptedGui('dynmap_r016_audit_all_views').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('dynmap_r016_palette_id', MakeScopeValue(GetPlayer.MakeScope.GetVariable('dynmap_r016_pair_cache_id').GetValueWithDefault(IntToFixedPoint('(int32)126')))).End )]"
                        button_icon = {
                            size = { 26 26 }
                            parentanchor = center
                            alwaystransparent = yes
                            texture = "gfx/interface/icons/flat_icons/map_modes/dejure_kingdoms.dds"
                            down = "[IsMapMode('dynmap_my_dynasty')]"
                        }
                    }
                    button_round = {
                        name = "dynmap_r016_view_holdings_audit"
                        parentanchor = center
                        size = { 40 40 }
                        visible = "[GetPlayer.IsValid]"
                        enabled = "[And(CanChangeMapMode, GetScriptedGui('dynmap_r016_check').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ))]"
                        down = "[IsMapMode('dynmap_dynasty_holdings')]"
                        tooltip = "dynmap_r016_holdings_tt"
                        onclick = "[GetScriptedGui('dynmap_r016_audit_all_views').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('dynmap_r016_palette_id', MakeScopeValue(GetPlayer.MakeScope.GetVariable('dynmap_r016_pair_cache_id').GetValueWithDefault(IntToFixedPoint('(int32)126')))).End )]"
                        button_icon = {
                            size = { 26 26 }
                            parentanchor = center
                            alwaystransparent = yes
                            texture = "gfx/interface/icons/holding_types_tab/castle_holding.dds"
                            down = "[IsMapMode('dynmap_dynasty_holdings')]"
                        }
                    }
                    button_round = {
                        name = "dynmap_r016_view_my_realm_audit"
                        parentanchor = center
                        size = { 40 40 }
                        visible = "[GetPlayer.IsValid]"
                        enabled = "[And(CanChangeMapMode, GetScriptedGui('dynmap_r016_check').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ))]"
                        down = "[IsMapMode('dynmap_my_realm_dynasty')]"
                        tooltip = "dynmap_r016_my_realm_tt"
                        onclick = "[GetScriptedGui('dynmap_r016_audit_all_views').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('dynmap_r016_palette_id', MakeScopeValue(GetPlayer.MakeScope.GetVariable('dynmap_r016_pair_cache_id').GetValueWithDefault(IntToFixedPoint('(int32)126')))).End )]"
                        button_icon = {
                            size = { 26 26 }
                            parentanchor = center
                            alwaystransparent = yes
                            texture = "gfx/interface/icons/flat_icons/house.dds"
                            down = "[IsMapMode('dynmap_my_realm_dynasty')]"
                        }
                    }
                }
            }
            flowcontainer = {
                name = "dynmap_r016_custom_header"
                parentanchor = hcenter
                direction = horizontal
                spacing = 10
                visible = "[And(GetPlayer.IsValid, Or3(IsMapMode('dynmap_my_dynasty'), IsMapMode('dynmap_dynasty_holdings'), IsMapMode('dynmap_my_realm_dynasty')))]"
                background = {
                    texture = "gfx/interface/component_tiles/tile_title_bg_01.dds"
                    spriteType = Corneredtiled
                    spriteborder = { 40 8 }
                    texture_density = 2
                    margin = { 40 0 }
                    modify_texture = {
                        name = "mask"
                        texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
                        blend_mode = alphamultiply
                    }
                }
                flowcontainer = {
                    name = "dynmap_r016_custom_header_text"
                    direction = vertical
                    ignoreinvisible = yes
                    margin = { 15 0 }
                    margin_top = 5
                    margin_bottom = 7
                    text_single = {
                        parentanchor = hcenter
                        text = "MAP_MODE_SHOWING_HEADER"
                        align = center
                        using = Font_Size_Medium
                    }
                    text_map_mode_header = { visible = "[IsMapMode('dynmap_my_dynasty')]" text = "dynmap_r016_realms" }
                    text_map_mode_header = { visible = "[IsMapMode('dynmap_dynasty_holdings')]" text = "dynmap_r016_holdings" }
                    text_map_mode_header = { visible = "[IsMapMode('dynmap_my_realm_dynasty')]" text = "dynmap_r016_my_realm" }
                }
                button_close = {
                    name = "dynmap_r016_back_to_realms"
                    parentanchor = vcenter
                    onclick = "[SetMapMode('realms')]"
                    down = "[IsMapMode('realms')]"
                    block "back_to_realms_shortcut" { shortcut = "close_window" }
                    tooltip = "dynmap_r016_back"
                    using = tooltip_se
                    background = { using = Background_Area_Dark margin = { 2 2 } }
                }
            }
        }
    }
}


# Separate top-of-viewport test overlay. It is independent of the bottom
# banner and does not filter pointer input; placement remains a user visual gate.
widget = {
    name = "dynmap_r016_pair_test_overlay"
    parentanchor = top|hcenter
    widgetanchor = top|hcenter
    position = { 0 6 }
    size = { 680 118 }
    layer = bottom_bottom
    visible = "[And(GetPlayer.IsValid, Or3(IsMapMode('dynmap_my_dynasty'), IsMapMode('dynmap_dynasty_holdings'), IsMapMode('dynmap_my_realm_dynasty')))]"
    filter_mouse = none
    alwaystransparent = yes
    state = { name = _show using = Animation_FadeIn_Quick }
    state = { name = _hide using = Animation_FadeOut_Standard }
    flowcontainer = {
        parentanchor = hcenter
        direction = vertical
        spacing = 1
        background = { using = Background_Area_Dark alpha = 0.45 }
        flowcontainer = { parentanchor = hcenter direction = horizontal spacing = 6 text_single = { raw_text = "Cached ID" using = Font_Size_Small } text_single = { raw_text = "[IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('dynmap_r016_pair_cache_id').GetValueWithDefault(IntToFixedPoint('(int32)126'))))]" using = Font_Size_Small } text_single = { raw_text = "Classification" using = Font_Size_Small } text_single = { raw_text = "[Select_CString(EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('dynmap_r016_pair_cache_id').GetValueWithDefault(IntToFixedPoint('(int32)126')), IntToFixedPoint('(int32)2')), 'Known Charles pair', 'Option B fallback')]" using = Font_Size_Small } }
        flowcontainer = { parentanchor = hcenter direction = horizontal spacing = 3 text_single = { raw_text = "Source c1 RGB" using = Font_Size_Small } text_single = { raw_text = "[IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('dynmap_r016_last_c1_r').GetValueWithDefault(IntToFixedPoint('(int32)-1'))))]" using = Font_Size_Small } text_single = { raw_text = "/" using = Font_Size_Small } text_single = { raw_text = "[IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('dynmap_r016_last_c1_g').GetValueWithDefault(IntToFixedPoint('(int32)-1'))))]" using = Font_Size_Small } text_single = { raw_text = "/" using = Font_Size_Small } text_single = { raw_text = "[IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('dynmap_r016_last_c1_b').GetValueWithDefault(IntToFixedPoint('(int32)-1'))))]" using = Font_Size_Small } }
        flowcontainer = { parentanchor = hcenter direction = horizontal spacing = 3 text_single = { raw_text = "Source c2 RGB" using = Font_Size_Small } text_single = { raw_text = "[IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('dynmap_r016_last_c2_r').GetValueWithDefault(IntToFixedPoint('(int32)-1'))))]" using = Font_Size_Small } text_single = { raw_text = "/" using = Font_Size_Small } text_single = { raw_text = "[IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('dynmap_r016_last_c2_g').GetValueWithDefault(IntToFixedPoint('(int32)-1'))))]" using = Font_Size_Small } text_single = { raw_text = "/" using = Font_Size_Small } text_single = { raw_text = "[IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('dynmap_r016_last_c2_b').GetValueWithDefault(IntToFixedPoint('(int32)-1'))))]" using = Font_Size_Small } }
        flowcontainer = { parentanchor = hcenter direction = horizontal spacing = 6 text_single = { raw_text = "Computed ID" using = Font_Size_Small } text_single = { raw_text = "[IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('dynmap_r016_last_painted_id').GetValueWithDefault(IntToFixedPoint('(int32)-1'))))]" using = Font_Size_Small } text_single = { raw_text = "[Select_CString(EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('dynmap_r016_last_painted_id').GetValueWithDefault(IntToFixedPoint('(int32)-1')), IntToFixedPoint('(int32)2')), 'Pair 2 callback reached', 'No pair 2 completion')]" using = Font_Size_Small } }
        flowcontainer = { visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('dynmap_r016_pair_cache_id').GetValueWithDefault(IntToFixedPoint('(int32)126')), IntToFixedPoint('(int32)2'))]" direction = horizontal icon = { size = { 12 12 } texture = "gfx/interface/component_masks/mask_circle.dds" color = { 0.5255 0.2314 0.1137 1 } } text_single = { raw_text = "Cached dark" using = Font_Size_Small } icon = { size = { 12 12 } texture = "gfx/interface/component_masks/mask_circle.dds" color = { 0.6902 0.5020 0.4235 1 } } text_single = { raw_text = "light" using = Font_Size_Small } }
        flowcontainer = { visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('dynmap_r016_pair_cache_id').GetValueWithDefault(IntToFixedPoint('(int32)126')), IntToFixedPoint('(int32)126'))]" direction = horizontal icon = { size = { 12 12 } texture = "gfx/interface/component_masks/mask_circle.dds" color = { 0.0980 0.4118 0.1961 1 } } text_single = { raw_text = "Cached B dark" using = Font_Size_Small } icon = { size = { 12 12 } texture = "gfx/interface/component_masks/mask_circle.dds" color = { 0.5686 0.8627 0.5882 1 } } text_single = { raw_text = "light" using = Font_Size_Small } }
        flowcontainer = { visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('dynmap_r016_last_painted_id').GetValueWithDefault(IntToFixedPoint('(int32)-1')), IntToFixedPoint('(int32)2'))]" direction = horizontal icon = { size = { 12 12 } texture = "gfx/interface/component_masks/mask_circle.dds" color = { 0.5255 0.2314 0.1137 1 } } text_single = { raw_text = "Computed dark" using = Font_Size_Small } icon = { size = { 12 12 } texture = "gfx/interface/component_masks/mask_circle.dds" color = { 0.6902 0.5020 0.4235 1 } } text_single = { raw_text = "light" using = Font_Size_Small } }
        flowcontainer = { visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('dynmap_r016_last_painted_id').GetValueWithDefault(IntToFixedPoint('(int32)-1')), IntToFixedPoint('(int32)126'))]" direction = horizontal icon = { size = { 12 12 } texture = "gfx/interface/component_masks/mask_circle.dds" color = { 0.0980 0.4118 0.1961 1 } } text_single = { raw_text = "Computed B dark" using = Font_Size_Small } icon = { size = { 12 12 } texture = "gfx/interface/component_masks/mask_circle.dds" color = { 0.5686 0.8627 0.5882 1 } } text_single = { raw_text = "light" using = Font_Size_Small } }
    }
}
